{
  "dataset": "cifar10",
  "data_dir": "./data",
  "output_dir": "./outputs/ivitt_backbone",
  "image_size": 224,
  "num_classes": 10,
  "epochs": 300,
  "batch_size": 128,
  "num_workers": 8,
  "pin_memory": true,
  "patch_size": 16,
  "embed_dim": 192,
  "depth": 12,
  "num_heads": 3,
  "mlp_ratio": 4.0,
  "drop_rate": 0.0,
  "attn_drop_rate": 0.0,
  "drop_path_rate": 0.1,
  "optimizer": "adamw",
  "lr": 0.0005,
  "weight_decay": 0.05,
  "warmup_epochs": 1,
  "min_lr": 1e-05,
  "clip_grad": 1.0,
  "smoothing": 0.1,
  "color_jitter": 0.3,
  "aa": "rand-m9-mstd0.5-inc1",
  "train_interpolation": "bicubic",
  "reprob": 0.25,
  "remode": "pixel",
  "recount": 1,
  "mixup": 0.8,
  "cutmix": 1.0,
  "cutmix_minmax": null,
  "mixup_prob": 1.0,
  "mixup_switch_prob": 0.5,
  "mixup_mode": "batch",
  "amp": true,
  "seed": 42,
  "device": "cuda",
  "resume": "",
  "save_freq": 20,
  "eval_only": false
}